{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/diagnostico",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "raiox-trader360(-rodrigo-cohen-s-projects)?\\.vercel\\.app"
        }
      ],
      "destination": "https://raiox.tradernation.com.br/:path*",
      "permanent": false
    }
  ]
}
